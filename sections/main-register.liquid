{{ 'customer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="customer register section-{{ section.id }}-padding">
  <svg style="display: none">
    <symbol id="icon-error" viewBox="0 0 13 13">
      <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
      <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
      <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
      <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
    </symbol>
  </svg>
  <h1>
    {{ 'customer.register.title' | t }}
  </h1>
  <form id="customer_register_gql">
    <div id="register-errors" class="form__message" style="display: none; color: red; margin-bottom: 1rem;"></div>
    <div id="register-success" class="form__message" style="display: none; color: green; margin-bottom: 1rem;"></div>

    <div class="field">
      <input type="text" name="firstName" id="RegisterForm-FirstName" placeholder="First Name">
      <label for="RegisterForm-FirstName">First Name</label>
    </div>

    <div class="field">
      <input type="text" name="lastName" id="RegisterForm-LastName" placeholder="Last Name">
      <label for="RegisterForm-LastName">Last Name</label>
    </div>

    <div class="field">
      <input type="email" name="email" id="RegisterForm-email" required placeholder="Email">
      <label for="RegisterForm-email">Email</label>
    </div>

    <div class="field">
      <input type="password" name="password" id="RegisterForm-password" required placeholder="Password">
      <label for="RegisterForm-password">Password</label>
    </div>

    <button type="submit" id="submitBtn">
      {{ 'customer.register.submit' | t }}
    </button>
  </form>
</div>

<script>
  document.querySelector('#customer_register_gql').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const formData = new FormData(e.target);
    const firstName = formData.get('firstName');
    const lastName = formData.get('lastName');
    const email = formData.get('email');
    const password = formData.get('password');
    const submitBtn = document.getElementById('submitBtn');

    const mutation = `
      mutation customerCreate($input: CustomerCreateInput!) {
        customerCreate(input: $input) {
          customer {
            id
            email
          }
          customerUserErrors {
            field
            message
          }
        }
      }
    `;

    try {
      submitBtn.setAttribute('disabled', true);

      const response = await fetch('/api/2024-01/graphql.json', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-Shopify-Storefront-Access-Token': window.ShopifyConfig.storefrontToken,
        },
        body: JSON.stringify({
          query: mutation,
          variables: {
            input: {
              firstName,
              lastName,
              email,
              password,
              acceptsMarketing: false
            }
          }
        }),
      });

      const { data, errors } = await response.json();
      
      if (data.customerCreate.customerUserErrors.length > 0) {
        const errorDiv = document.getElementById('register-errors');
        errorDiv.innerHTML = data.customerCreate.customerUserErrors
          .map(err => `<span>${err.message}</span>`)
          .join('<br>');
        errorDiv.style.display = 'block';
      } else {
        const successDiv = document.getElementById('register-success');
        successDiv.innerHTML = '<span>New Account Created</span>';
        successDiv.style.display = 'block';
      }
    } catch (err) {
      console.error("Registration failed", err);
    }

    submitBtn.removeAttribute('disabled');
  });
</script>

{% schema %}
{
  "name": "t:sections.main-register.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
